---
interface Props {
  title: string;
  description: string;
  tags: string[];
  repoUrl?: string;
  liveUrl?: string;
}

const { title, description, tags, repoUrl, liveUrl } = Astro.props;
---

<article class="flex flex-col gap-3 rounded-xl border border-neutral-200 p-6 dark:border-neutral-800">
  <h3 class="text-lg font-semibold">{title}</h3>
  <p class="text-sm text-neutral-600 dark:text-neutral-400">{description}</p>
  {
    tags.length > 0 && (
      <ul class="flex flex-wrap gap-2 text-xs">
        {tags.map((tag) => (
          <li class="rounded-full bg-neutral-100 px-2.5 py-1 text-neutral-600 dark:bg-neutral-900 dark:text-neutral-400">
            {tag}
          </li>
        ))}
      </ul>
    )
  }
  <div class="mt-auto flex gap-4 pt-2 text-sm font-medium">
    {liveUrl && <a href={liveUrl} class="text-neutral-900 hover:underline dark:text-white">Live →</a>}
    {repoUrl && <a href={repoUrl} class="text-neutral-900 hover:underline dark:text-white">Code →</a>}
  </div>
</article>
